# =============================================================================
# [공통 설정]
# =============================================================================
# Synology DSM 계정 권한 (SSH 에서 'id' 명령어로 확인한 UID/GID)
PUID=1026
PGID=100
TZ=Asia/Seoul

# (선택) 날짜별 하위 분류 폴더명 (기본값: RAW / JPG / Video / Export)
# RAW_DIR_NAME=RAW
# JPG_DIR_NAME=JPG
# VIDEO_DIR_NAME=Video
# EXPORT_DIR_NAME=Export

# (선택) Export 빈 폴더 생성 여부 (true | false, 기본값: false)
# CREATE_EXPORT_DIR=false

# (선택) 로그 레벨: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# =============================================================================
# [데몬 모드 전용 (docker compose / 상시 감시)]
# =============================================================================
# 동일 파일시스템 내 고속 즉시 이동(os.rename)을 위해 상위 공통 볼륨을 /media 로 단일 마운트합니다.
HOST_BASE_DIR=/volume1

# 컨테이너 내부 기준 경로 (/media 하위 경로로 지정)
INPUT_DIR=/media/photo_inbox
TARGET_DIR=/media/homes/username/Photos

# 감시 및 안정화 주기 (초 단위)
CHECK_INTERVAL=15
SETTLE_THRESHOLD=30
STABLE_ROUNDS=2

# =============================================================================
# [일회성(oneshot) 실행 참고사항]
# =============================================================================
# 일회성 실행은 정리할 호스트 폴더를 컨테이너의 /input 에 단일 마운트하여 실행합니다:
#   docker run --rm --env-file .env -v /volume1/photo_inbox:/input media-sorter \
#     python -m src.main oneshot --no-settle --dry-run
