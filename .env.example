# =============================================================================
# [공통 설정]
# =============================================================================
# Synology DSM 계정 권한 (SSH 에서 'id' 명령어로 확인한 UID/GID)
PUID=1026
PGID=100
TZ=Asia/Seoul

# (선택) 로그 레벨: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# =============================================================================
# [데몬 모드 전용 (docker compose / 상시 감시)]
# =============================================================================
# 호스트 기준 경로 (수신 폴더 -> 최종 Photos 대상 폴더 분리)
HOST_INPUT_DIR=/volume1/photo_inbox
HOST_TARGET_DIR=/volume1/homes/username/Photos

# 컨테이너 내부 경로 (기본값 유지)
INPUT_DIR=/input
TARGET_DIR=/photos

# 감시 및 안정화 주기 (초 단위)
# CHECK_INTERVAL   : 디렉터리 폴링 주기
# SETTLE_THRESHOLD : 크기/mtime 이 변하지 않고 유지되어야 하는 최소 시간
# STABLE_ROUNDS    : 동일 상태가 연속 유지되어야 하는 폴링 횟수
CHECK_INTERVAL=15
SETTLE_THRESHOLD=30
STABLE_ROUNDS=2

# =============================================================================
# [일회성(oneshot) 실행 참고사항]
# =============================================================================
# 일회성 실행은 특정 폴더 내부에서 제자리(in-place) 분류 및 리네이밍을 수행하므로,
# 별도의 TARGET_DIR 없이 INPUT_DIR 하나만 사용합니다 (TARGET_DIR이 있어도 무시됨).
#
# Docker 단독 실행 시 정리할 호스트 폴더를 /input 에 단일 마운트하여 실행합니다:
#   docker run --rm --env-file .env -v ${HOST_INPUT_DIR}:/input media-sorter \
#     python -m src.main oneshot --dry-run
