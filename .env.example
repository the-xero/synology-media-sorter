# Synology DSM 계정 권한 (SSH 에서 'id' 명령어로 확인한 UID/GID)
PUID=1026
PGID=100

# 경로 설정 (호스트 기준 경로)
HOST_INPUT_DIR=/volume1/photo_inbox
HOST_TARGET_DIR=/volume1/homes/username/Photos

# 컨테이너 내부 경로 (기본값 유지)
INPUT_DIR=/input
TARGET_DIR=/photos

# 감시 및 안정화 주기 (초 단위)
# CHECK_INTERVAL   : 디렉터리 폴링 주기
# SETTLE_THRESHOLD : 크기/mtime 이 변하지 않고 유지되어야 하는 최소 시간
# STABLE_ROUNDS    : 동일 상태가 연속 유지되어야 하는 폴링 횟수
CHECK_INTERVAL=15
SETTLE_THRESHOLD=30
STABLE_ROUNDS=2
TZ=Asia/Seoul

# (선택) 로그 레벨: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
